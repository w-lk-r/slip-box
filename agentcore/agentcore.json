{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "SlipBox",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "SlipBox"
  },
  "runtimes": [
    {
      "name": "MyAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/MyAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "S3_BUCKET", "value": "slip-box-notes" },
        { "name": "KB_ID", "value": "EHSL8ZENQX" },
        { "name": "ITEMS_TABLE", "value": "slip-box-items" },
        { "name": "EDGES_TABLE", "value": "slip-box-edges" },
        { "name": "SOURCES_TABLE", "value": "slip-box-sources" },
        { "name": "INGEST_SESSIONS_TABLE", "value": "slip-box-ingest-sessions" }
      ],
      "additionalPolicies": [
        "policies/agent-permissions.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [
    {
      "type": "AgentCoreKnowledgeBase",
      "name": "SlipCaseKB",
      "description": "Slip case notes — ingested items stored as .md files, synced for semantic retrieval",
      "dataSources": [
        {
          "type": "S3",
          "uri": "s3://slip-box-notes"
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}